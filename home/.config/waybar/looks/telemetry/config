{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [
        "custom/debian",
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "mpris",
        "clock"
    ],
    "modules-right": [
        "custom/cpu",
        "custom/gpu",
        "custom/mem",
        "custom/net",
        "backlight",
        "pulseaudio",
        "pulseaudio#mic",
        "network",
        "battery",
        "tray",
        "custom/telemetryd"
    ],
    "custom/telemetryd": {
        "exec": "python3 ~/.config/waybar/looks/telemetry/telemetryd.py",
        "return-type": "json",
        "restart-interval": 5,
        "tooltip": false
    },
    "custom/debian": {
        "format": "",
        "tooltip-format": "Open apps",
        "on-click": "fuzzel"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "󰩺  {}"
    },
    "mpris": {
        "format": "{status_icon}  {dynamic}",
        "dynamic-order": [
            "title",
            "artist"
        ],
        "dynamic-len": 38,
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤",
            "stopped": "󰓛"
        },
        "tooltip-format": "{player}\n{dynamic}"
    },
    "clock": {
        "format": "{:%a %d %b   %I:%M %p}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "backlight": {
        "device": "nvidia_wmi_ec_backlight",
        "format": "{icon} {percent}%",
        "on-scroll-up": "brightnessctl -q -d nvidia_wmi_ec_backlight set +2%",
        "on-scroll-down": "brightnessctl -q -d nvidia_wmi_ec_backlight set 2%-",
        "tooltip-format": "Brightness {percent}%\nScroll to change",
        "smooth-scrolling-threshold": 1,
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ]
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "on-click": "~/.config/sway/toggle-mute.sh speaker",
        "on-scroll-up": "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "tooltip-format": "{desc}  {volume}%\nScroll to change, click to mute",
        "smooth-scrolling-threshold": 1,
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        }
    },
    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-muted": "{format_source}",
        "format-bluetooth": "{format_source}",
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "Mic {source_volume}%\nClick to mute, scroll to change",
        "on-click": "~/.config/sway/toggle-mute.sh mic",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-",
        "smooth-scrolling-threshold": 1
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "on-click": "foot --app-id=floating-terminal --window-size-pixels=750x550 nmtui",
        "format-icons": [
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ]
    },
    "tray": {
        "icon-size": 15,
        "spacing": 10
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "tooltip-format": "{timeTo}\n{power:.1f} W",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "custom/cpu": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-telemetry/cpu.json\" 2>/dev/null",
        "return-type": "json",
        "interval": 1,
        "on-click": "foot --app-id=floating-terminal --window-size-chars=100x25 btop"
    },
    "custom/gpu": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-telemetry/gpu.json\" 2>/dev/null",
        "return-type": "json",
        "interval": 1
    },
    "custom/mem": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-telemetry/mem.json\" 2>/dev/null",
        "return-type": "json",
        "interval": 1,
        "on-click": "foot --app-id=floating-terminal --window-size-chars=100x25 btop"
    },
    "custom/net": {
        "exec": "cat \"$XDG_RUNTIME_DIR/waybar-telemetry/net.json\" 2>/dev/null",
        "return-type": "json",
        "interval": 1,
        "on-click": "foot --app-id=floating-terminal --window-size-pixels=750x550 nmtui"
    }
}