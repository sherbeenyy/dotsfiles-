#!/bin/bash
# Hybrid laptop: Intel iGPU renders and drives the laptop panel, NVIDIA dGPU
# drives the HDMI port. Sway 1.9 (wlroots 0.17) has no explicit sync, and its
# GLES renderer doesn't wait for cross-GPU fences, which shows up as
# glitching/flicker on the NVIDIA-driven external monitor. The Vulkan
# renderer does wait on those fences.
export WLR_RENDERER=vulkan

# Fix invisible cursor on NVIDIA
export WLR_NO_HARDWARE_CURSORS=1
export XDG_SESSION_TYPE=wayland
# User-installed tools (satty, nvidia-run) for keybindings and apps started by sway
export PATH="$HOME/.local/bin:$PATH"

# Legacy (non-atomic) KMS makes multi-GPU output worse; nvidia_drm modeset=1 supports atomic.
unset WLR_DRM_NO_ATOMIC
# Don't force NVIDIA GBM/GLX/VAAPI onto an Intel-rendered desktop.
# Run a single app on the dGPU with: nvidia-run <app>
unset GBM_BACKEND __GLX_VENDOR_LIBRARY_NAME LIBVA_DRIVER_NAME

# Pin GPU order (Intel primary) by PCI address; cardN numbers can change between boots.
intel=$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-card)
nvidia=$(readlink -f /dev/dri/by-path/pci-0000:01:00.0-card)
[ -e "$intel" ] && [ -e "$nvidia" ] && export WLR_DRM_DEVICES="$intel:$nvidia"

# If sway dies right away (e.g. Vulkan renderer fails), retry with the default renderer
start=$(date +%s)
sway --unsupported-gpu "$@"
rc=$?
if [ $rc -ne 0 ] && [ $(( $(date +%s) - start )) -lt 10 ]; then
    unset WLR_RENDERER
    exec sway --unsupported-gpu "$@"
fi
exit $rc
