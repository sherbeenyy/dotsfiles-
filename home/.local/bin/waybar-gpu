#!/usr/bin/python3
"""Waybar module: NVIDIA GPU usage on the bar, both GPUs' details in the tooltip.

Prints one JSON line per update for a waybar custom module. nvidia-smi is never
run while the card sleeps, because that would wake it, and it runs rarely while
the card is idle, so the polling itself doesn't keep the card awake on battery.
"""
import json
import subprocess
import time
from pathlib import Path

UPDATE_SECONDS = 3
IDLE_NVIDIA_POLL_SECONDS = 30
ICON = "󰢮"
NVIDIA_QUERY = ("name,utilization.gpu,memory.used,memory.total,"
                "temperature.gpu,power.draw,clocks.gr,clocks.max.gr")


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def find_pci_display(vendor):
    for device in Path("/sys/bus/pci/devices").iterdir():
        if read(device / "vendor") == vendor and read(device / "class").startswith("0x03"):
            return device
    return None


def find_intel_gt():
    for card in Path("/sys/class/drm").glob("card[0-9]"):
        gt = card / "gt/gt0"
        if read(card / "device/vendor") == "0x8086" and (gt / "rc6_residency_ms").exists():
            return gt
    return None


def query_nvidia():
    try:
        out = subprocess.run(["nvidia-smi", f"--query-gpu={NVIDIA_QUERY}",
                              "--format=csv,noheader,nounits"],
                             capture_output=True, text=True, timeout=4).stdout
        name, usage, used, total, temp, power, clock, max_clock = [
            field.strip() for field in out.splitlines()[0].split(",")]
        return {"name": name.replace("NVIDIA GeForce ", ""), "usage": int(usage),
                "used": int(used), "total": int(total), "temp": temp, "power": power,
                "clock": clock, "max_clock": max_clock}
    except (subprocess.SubprocessError, OSError, IndexError, ValueError):
        return None


class IntelUsage:
    """Estimates load without root: the time the GPU spent outside its RC6 sleep state."""

    def __init__(self, gt):
        self.gt = gt
        self.last = self.sample()

    def sample(self):
        residency = read(self.gt / "rc6_residency_ms") if self.gt else ""
        return (time.monotonic(), int(residency)) if residency.isdigit() else None

    def read(self):
        previous, self.last = self.last, self.sample()
        if not previous or not self.last or self.last[0] <= previous[0]:
            return None
        elapsed_ms = (self.last[0] - previous[0]) * 1000
        return round(max(0.0, min(100.0, 100 * (1 - (self.last[1] - previous[1]) / elapsed_ms))))


def nvidia_lines(stats, awake):
    if not awake:
        return ["NVIDIA", "  Asleep"]
    if not stats:
        return ["NVIDIA", "  Stats unavailable"]
    return [stats["name"],
            f"  Usage  {stats['usage']}%",
            f"  VRAM   {stats['used'] / 1024:.1f} / {stats['total'] / 1024:.1f} GiB",
            f"  Temp   {stats['temp']}°C",
            f"  Power  {stats['power']} W",
            f"  Clock  {stats['clock']} / {stats['max_clock']} MHz"]


def intel_lines(gt, usage):
    if not gt:
        return []
    shown = f"~{usage}%" if usage is not None else "measuring…"
    return ["", "Intel (draws the desktop)",
            f"  Usage  {shown}",
            f"  Clock  {read(gt / 'rps_act_freq_mhz')} / {read(gt / 'rps_max_freq_mhz')} MHz"]


def main():
    nvidia = find_pci_display("0x10de")
    gt = find_intel_gt()
    intel = IntelUsage(gt)
    stats, last_poll = None, 0.0
    while True:
        awake = bool(nvidia) and read(nvidia / "power/runtime_status") == "active"
        if not awake:
            stats = None
        else:
            idle = stats is not None and stats["usage"] == 0
            wait = IDLE_NVIDIA_POLL_SECONDS if idle else UPDATE_SECONDS
            if time.monotonic() - last_poll >= wait:
                stats = query_nvidia()
                last_poll = time.monotonic()

        usage = stats["usage"] if stats else 0
        print(json.dumps({
            "text": f"{ICON}  {usage}%",
            "tooltip": "\n".join(nvidia_lines(stats, awake) + intel_lines(gt, intel.read())),
            "class": "active" if awake else "asleep",
        }), flush=True)
        time.sleep(UPDATE_SECONDS)


if __name__ == "__main__":
    main()
